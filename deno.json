{
  "compilerOptions": {
    "lib": [
      "dom",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ],
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "lint": {
    "rules": {
      "include": [
        "eqeqeq",
        "no-await-in-loop"
      ],
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check .",
    "convert_to_webp": "deno run -R=. -W=. scripts/convert_to_webp.ts",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "imports": {
    "@/": "./",
    "@core/unknownutil": "jsr:@core/unknownutil@^4.3.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@preact/signals": "npm:@preact/signals@^2.11.2",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.8",
    "react-icons": "npm:react-icons@^5.7.0",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^6.4.3"
  }
}
